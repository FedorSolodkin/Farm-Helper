# Скопируйте этот файл в secrets.env рядом с server.py и впишите значения.
# Файл с настоящими ключами не загружайте в репозиторий и не отправляйте никому.
LLM_MODE=env
LLM_BASE_URL=https://llm.api.cloud.yandex.net/v1
LLM_API_KEY=
LLM_PROJECT=
LLM_MODEL=gpt://ВАШ_ID_КАТАЛОГА/yandexgpt/latest
HOST=0.0.0.0
SESSIONS=1
# AUTH=0          # отключить вход по почте и паролю (все как гости)
# DATA_DIR=./data  # где хранить кабинеты
